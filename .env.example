# Copy to .env. Passwords and keys are files in secrets/, never variables here.

# Published on 127.0.0.1 only.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OTLP_HTTP_PORT=4318

# docker0's address; node-exporter listens on it. Check with: ip -4 addr show docker0
DOCKER_HOST_IP=172.17.0.1

# Read only when the grafana-data volume is created.
GRAFANA_ADMIN_USER=admin
# true once Grafana is served over HTTPS.
GRAFANA_COOKIE_SECURE=false

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=clarifin
POSTGRES_EXPORTER_USER=postgres_exporter
# require once the database is on another host.
POSTGRES_SSLMODE=disable
